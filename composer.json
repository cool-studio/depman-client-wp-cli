{
    "name": "depman/wp-cli-client",
    "description": "Reports the plugins, themes and core installed on a WordPress site to DepMan, as a WP-CLI command.",
    "type": "wp-cli-package",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "php-stubs/wordpress-stubs": "^6.0",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Depman\\WpCli\\": "src/"
        },
        "files": [
            "command.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Depman\\WpCli\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "phpstan analyse --no-progress --memory-limit=1G -c phpstan-tests.neon"
        ],
        "test": [
            "phpunit --testsuite client"
        ],
        "smoke": [
            "phpunit --testsuite smoke"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@smoke"
        ],
        "floor": [
            "@analyse",
            "@test",
            "@smoke"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
